# demo works without a key; openai enables the live tool-calling agent.
AGENT_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Standalone GPT-Live voice (independent of AGENT_PROVIDER).
OPENAI_VOICE_MODEL=gpt-live-1
OPENAI_VOICE=meridian
OPENAI_VOICE_BACKEND_MODEL=gpt-6-luna
VOICE_HUMOR=70
# Optional local open-weight model (install/pull separately).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
